    "query": "query getCustomer($customerId: String!) {\n  getCustomer(id: $customerId) {\n    ...CustomerData\n    __typename\n  }\n}\n\nfragment CustomerData on Customer {\n  id\n  name\n  customerType\n  extendedAttributes\n  contactMedium {\n    id\n    preferred\n    type\n    mediumType\n    isVerified\n    contactHour {\n      dayOfWeek\n      startTime\n      endTime\n      __typename\n    }\n    characteristic {\n      type\n      phoneNumber\n      emailAddress\n      country\n      postCode\n      stateOrProvince\n      city\n      street1\n      street2\n      billingData {\n        addressFormat\n        __typename\n      }\n      extendedAttributes\n      extendedParameters\n      __typename\n    }\n    __typename\n  }\n  engagedParty {\n    id\n    atReferredType\n    origin {\n      ... on Individual {\n        familyName\n        fullName\n        givenName\n        middleName\n        birthDate\n        gender\n        extendedAttributes\n        languageRef {\n          isoCode\n          __typename\n        }\n        contactMedium {\n          id\n          preferred\n          type\n          mediumType\n          isActive\n          isVerified\n          characteristic {\n            type\n            phoneNumber\n            emailAddress\n            country\n            postCode\n            stateOrProvince\n            city\n            street1\n            street2\n            billingData {\n              addressFormat\n              __typename\n            }\n            extendedAttributes\n            extendedParameters\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      ... on Organization {\n        contactMedium {\n          id\n          preferred\n          type\n          mediumType\n          isActive\n          isVerified\n          characteristic {\n            type\n            phoneNumber\n            emailAddress\n            country\n            postCode\n            stateOrProvince\n            city\n            street1\n            street2\n            extendedAttributes\n            billingData {\n              addressFormat\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        extendedAttributes\n        id\n        languageRef {\n          isoCode\n          __typename\n        }\n        type\n        billingData {\n          contactType\n          __typename\n        }\n        atType\n        fullName\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  relatedParty {\n    id\n    role\n    name\n    atReferredType\n    validFor {\n      startDateTime\n      endDateTime\n      __typename\n    }\n    origin {\n      ... on Individual {\n        contactMedium {\n          ...ContactMediumFragment\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  __typename\n}\n\nfragment ContactMediumFragment on ContactMedium {\n  id\n  type\n  mediumType\n  preferred\n  characteristic {\n    emailAddress\n    phoneNumber\n    country\n    postCode\n    stateOrProvince\n    city\n    street1\n    street2\n    type\n    extendedAttributes\n    extendedParameters\n    __typename\n  }\n  __typename\n}",
